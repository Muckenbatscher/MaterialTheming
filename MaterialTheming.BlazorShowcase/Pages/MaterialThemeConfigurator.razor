@page "/"

<PageTitle>Material Theming</PageTitle>

<ThemeCreationInputs OnInputsChanged="OnThemeInputsChanged" />

<ThemeDisplay Theme="_theme" />
<MudThemeProvider Theme="@_mudTheme" IsDarkMode="_isDarkMode" />

@code {
    private const string DotNetBrandColor = "#512BD4";
    private ThemeColors? _theme = ThemeBuilder.CreateFromSourceColor(DotNetBrandColor).Build();
    private MudTheme? _mudTheme;
    private bool _isDarkMode;


    private ThemeCreationInputParameters themeInput;

    public MaterialThemeConfigurator()
    {
        themeInput = new ThemeCreationInputParameters()
        {
            SourceColor = RgbColor.FromHtml("#512BD4"),
            SecondSourceColor = RgbColor.FromHtml("#512BD4"),
            Variant = MaterialTheming.Variant.TonalSpot,
            Mode = ThemeMode.Light,
            Contrast = ContrastLevel.Normal,
            SpecVersion = SpecVersion.Spec2021,
            Platform = Platform.Phone
        };
        GenerateTheme();
    }
    private async Task OnThemeInputsChanged(ThemeCreationInputParameters args)
    {
        themeInput = args;
        GenerateTheme();
    }

    private void GenerateTheme()
    {
        var builder = ThemeBuilder
            .CreateFromSourceColor(themeInput.SourceColor)
            .WithVariant(themeInput.Variant)
            .WithMode(themeInput.Mode)
            .WithContrastLevel(themeInput.Contrast)
            .WithSpecVersion(themeInput.SpecVersion)
            .WithPlatform(themeInput.Platform);
        if (themeInput.SecondSourceColor is not null)
            builder.WithSecondSourceColor(themeInput.SecondSourceColor);

        _theme = builder.Build();

        _mudTheme = builder.BuildMudTheme();
        _isDarkMode = themeInput.Mode == ThemeMode.Dark;
    }
}
